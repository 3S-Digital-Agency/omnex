# VITE_USE_MOCKS=false   -> use the real Laravel API (set VITE_API_BASE_URL too)
# VITE_USE_MOCKS=true    -> use the built-in in-browser mock (default; no backend needed)
VITE_USE_MOCKS=true
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Optional reCAPTCHA v3 site key — enables the client-side challenge on the
# contact form. The backend secret must be configured to match.
# VITE_RECAPTCHA_SITE_KEY=
