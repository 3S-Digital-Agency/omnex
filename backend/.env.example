[TEMPLATE]
APP_NAME=OMNEX
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

FRONTEND_URL=http://127.0.0.1:5173

# --- Database (PostgreSQL, portable dev server on 127.0.0.1:5433) ------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=omnex
DB_USERNAME=omnex
DB_PASSWORD=

# --- Cache / queue / session -------------------------------------------------
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database

# --- Auth --------------------------------------------------------------------
# Password-less external sign-in (SdP, Google, Microsoft, Apple, Facebook,
# Amazon, GitHub, OpenAI). A provider appears in the UI only when its
# credentials are set (config/socialauth.php).
SDP_CLIENT_ID=
SDP_CLIENT_SECRET=
SDP_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/sdp/callback
SDP_BASE_URL=https://serveursdupeuple.ca

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/microsoft/callback

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/apple/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/facebook/callback

AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/amazon/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/github/callback

OPENAI_CLIENT_ID=
OPENAI_CLIENT_SECRET=
OPENAI_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/openai/callback

# Time-to-live (seconds) of the pending external sign-in completion token.
SOCIAL_COMPLETION_TTL=600

# --- Domain + DNS providers (Phase 3) ----------------------------------------
OMNEX_DOMAIN_PROVIDER=sandbox
OMNEX_DNS_PROVIDER=sandbox
OMNEX_DOMAIN_REGISTRATION_YEARS=1
OMNEX_DOMAIN_EXPIRATION_WARNING_DAYS=30

# Namecheap (activate by setting OMNEX_DOMAIN_PROVIDER=namecheap)
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=
NAMECHEAP_CLIENT_IP=
NAMECHEAP_ENDPOINT=https://api.namecheap.com/xml.response
# Default registrant contact (used when registering domains)
NAMECHEAP_FIRST_NAME=
NAMECHEAP_LAST_NAME=
NAMECHEAP_ADDRESS1=
NAMECHEAP_ADDRESS2=
NAMECHEAP_CITY=
NAMECHEAP_STATE_PROVINCE=
NAMECHEAP_POSTAL_CODE=
NAMECHEAP_COUNTRY=CA
NAMECHEAP_PHONE=
NAMECHEAP_EMAIL_ADDRESS=

# OVH (activate by setting OMNEX_DOMAIN_PROVIDER=ovh)
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
OVH_ENDPOINT=ovh-eu
OVH_SUBSIDIARY=CA

# Custom registrar/DNS (activate by setting the provider to `custom`)
CUSTOM_REGISTRAR_ENDPOINT=
CUSTOM_REGISTRAR_API_KEY=
CUSTOM_DNS_ENDPOINT=
CUSTOM_DNS_API_KEY=

# --- Storage / OMNEX Drive (Phase 4) -----------------------------------------
OMNEX_STORAGE_PROVIDER=sandbox
OMNEX_STORAGE_QUOTA_BYTES=10737418240
OMNEX_STORAGE_SIGNED_URL_TTL=300

OMNEX_STORAGE_S3_ENDPOINT=
OMNEX_STORAGE_S3_REGION=us-east-1
OMNEX_STORAGE_S3_BUCKET=
OMNEX_STORAGE_S3_KEY=
OMNEX_STORAGE_S3_SECRET=

# --- Sites (Phase 5) ---------------------------------------------------------
OMNEX_SITE_PROVIDER=sandbox
OMNEX_SITE_DEFAULT_BRANCH=main

# Custom site provider (activate by setting OMNEX_SITE_PROVIDER=custom)
CUSTOM_SITE_ENDPOINT=
CUSTOM_SITE_API_KEY=

# --- OMNEX Cloud (Phase 8) ------------------------------------------------------
OMNEX_CLOUD_PROVIDER=sandbox
OMNEX_CLOUD_DEFAULT_REGION=fsn1
OMNEX_CLOUD_DEFAULT_PLAN=cpx11
OMNEX_CLOUD_DEFAULT_IMAGE=ubuntu-24.04
# Real-time metrics stream (SSE): seconds between samples and max connection
# lifetime before the client reconnects.
OMNEX_CLOUD_METRICS_SSE_INTERVAL=5
OMNEX_CLOUD_METRICS_SSE_MAX_SECONDS=120
# Max samples returned by GET /cloud/{server}/metrics/history (sparkline).
OMNEX_CLOUD_METRICS_HISTORY_LIMIT=60
# Threshold alerts: usage percent that triggers a `server.alert` notification
# and the minimum seconds between two alerts of the same metric on a server.
OMNEX_CLOUD_ALERT_CPU_PERCENT=90
OMNEX_CLOUD_ALERT_MEMORY_PERCENT=90
OMNEX_CLOUD_ALERT_DISK_PERCENT=90
OMNEX_CLOUD_ALERT_COOLDOWN_SECONDS=3600
# Scheduled snapshots/backups: default retention (days) and default frequency
# applied to new servers (disabled | daily | weekly). Per-server settings are
# editable in the UI; `omnex:server-snapshots` (scheduled daily) creates due
# snapshots and prunes expired ones.
OMNEX_CLOUD_SNAPSHOT_RETENTION_DAYS=7
OMNEX_CLOUD_SNAPSHOT_FREQUENCY=disabled
# Encrypted private-key vault: cipher + PBKDF2 iterations used to seal a
# generated private key when a vault password is chosen (SshKeyService).
# Higher iterations = stronger KDF, at a small CPU cost per seal/unlock.
OMNEX_CLOUD_SSH_VAULT_CIPHER=aes-256-gcm
OMNEX_CLOUD_SSH_VAULT_PBKDF2_ITERATIONS=210000

# Hetzner (activate by setting OMNEX_CLOUD_PROVIDER=hetzner)
HETZNER_API_TOKEN=
HETZNER_DEFAULT_LOCATION=fsn1
HETZNER_DEFAULT_SERVER_TYPE=cpx11
HETZNER_DEFAULT_IMAGE=ubuntu-24.04
HETZNER_SSH_KEY_ID=

# DigitalOcean (activate by setting OMNEX_CLOUD_PROVIDER=digitalocean)
DO_API_TOKEN=
DO_DEFAULT_REGION=nyc1
DO_DEFAULT_SIZE=s-1vcpu-1gb
DO_DEFAULT_IMAGE=ubuntu-24-04-x64
DO_SSH_KEY_ID=

# Custom cloud gateway (activate by setting OMNEX_CLOUD_PROVIDER=custom)
CUSTOM_CLOUD_ENDPOINT=
CUSTOM_CLOUD_API_KEY=

# Validate cloud tokens WITHOUT provisioning (read-only, no cost):
#   php artisan omnex:cloud:verify-providers            # all providers
#   php artisan omnex:cloud:verify-providers hetzner    # one provider
# or GET /api/v1/cloud/providers/verify (authenticated).

# --- OMNEX Billing (payments) -------------------------------------------------
# OMNEX_BILLING_PROVIDER selects the gateway: sandbox (in-memory) or stripe.
# The Stripe provider activates only once its keys are filled in.
#
# To wire real Stripe test mode end-to-end:
#   1. STRIPE_SECRET_KEY        — sk_test_... from the Stripe dashboard.
#   2. Run `php artisan omnex:stripe-sync-prices` once to create a Stripe
#      Price per plan and store its id on `plans.stripe_price_id`.
#      If you use coupons, run `php artisan omnex:stripe-sync-coupons` the
#      same way so Checkout Sessions can reference `coupons.stripe_coupon_id`.
#   3. STRIPE_WEBHOOK_SECRET    — whsec_... printed by the Stripe CLI:
#        stripe listen --forward-to http://127.0.0.1:8000/api/v1/billing/webhooks/stripe
#      (or set the endpoint https://<host>/api/v1/billing/webhooks/stripe in
#      the dashboard and copy its signing secret).
#   4. Set OMNEX_BILLING_PROVIDER=stripe.

OMNEX_BILLING_PROVIDER=sandbox
OMNEX_BILLING_CURRENCY=usd

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Real-time streams (SSE) --------------------------------------------------
# Driver: inprocess (default, single process) | redis (pub/sub multi-process)
OMNEX_STREAM_DRIVER=inprocess
OMNEX_STREAM_PREFIX=omnex:
OMNEX_STREAM_REDIS_CONNECTION=default

# Max lifetime of one SSE connection and heartbeat interval (seconds).
OMNEX_NOTIFICATIONS_SSE_MAX_SECONDS=60
OMNEX_NOTIFICATIONS_SSE_HEARTBEAT_SECONDS=15
OMNEX_ACTIVITY_SSE_MAX_SECONDS=60
OMNEX_ACTIVITY_SSE_HEARTBEAT_SECONDS=15

# --- Redis (used by the redis stream driver) ----------------------------------
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Tenant isolation ---------------------------------------------------------
# PostgreSQL Row-Level Security is defense-in-depth on top of the app-level
# global scope. Keep OFF unless the RLS test suite passes (docs/security.md).
OMNEX_ENFORCE_RLS=false

# --- Localization --------------------------------------------------------------
# Locales a user may select in their account settings.
OMNEX_LOCALES=en,fr

# --- Public contact leads (anti-spam) -------------------------------------------
# Max submissions per IP per minute on POST /v1/public/leads.
OMNEX_LEADS_RATE_LIMIT=5
# Optional reCAPTCHA v3. Leave OMNEX_RECAPTCHA_SECRET empty to disable the
# challenge; set it (server secret) and the frontend site key to enable.
OMNEX_RECAPTCHA_SECRET=
OMNEX_RECAPTCHA_SCORE_THRESHOLD=0.5
