[TEMPLATE]
APP_NAME="OMNEX"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nexus
DB_USERNAME=nexus
DB_PASSWORD=nexus

CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=sync

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_CLIENT=phpredis

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@omnex.dev
MAIL_FROM_NAME="${APP_NAME}"

# Tenant isolation defense-in-depth. Enable AFTER the RLS test suite passes
# against PostgreSQL. While false, the application-level global scope is the
# enforced isolation layer (see docs/security.md).
NEXUS_ENFORCE_RLS=false

# --- Social login (GAFAM OAuth / OpenID Connect) -----------------------------
# The sandbox provider needs no keys and is always available. Each real
# provider activates only once its credentials are filled in. The redirect URI
# registered with the provider must be:
#   {APP_URL}/api/v1/auth/{provider}/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REDIRECT_URI=
