APP_NAME="OMNEX"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=omnex
DB_USERNAME=omnex
DB_PASSWORD=omnex

CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=sync

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_CLIENT=phpredis

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@omnex.dev
MAIL_FROM_NAME="${APP_NAME}"

# Tenant isolation defense-in-depth. Enable AFTER the RLS test suite passes
# against PostgreSQL. While false, the application-level global scope is the
# enforced isolation layer (see docs/security.md).
OMNEX_ENFORCE_RLS=false

# --- Social login (GAFAM + sovereign OAuth / OpenID Connect) -----------------
# The sandbox provider needs no keys and is always available. Each real
# provider activates only once its credentials are filled in. The redirect URI
# registered with the provider must be:
#   {APP_URL}/api/v1/auth/{provider}/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REDIRECT_URI=

# Serveurs du Peuple — Nextcloud OAuth2 (sovereign identity provider).
# The id is the Nextcloud username (not the email); email is not asserted
# verified. Base URL defaults to SdP's cloud instance.
SDP_BASE_URL=https://cloud.serveursdupeuple.net
SDP_CLIENT_ID=
SDP_CLIENT_SECRET=
SDP_REDIRECT_URI=

# --- Domain registrars (multi-provider) --------------------------------------
# OMNEX_DOMAIN_PROVIDER is the default registrar used when a request does not
# pass an explicit `provider`. Each real registrar activates only once its
# credentials are filled in. The sandbox needs no keys.

OMNEX_DOMAIN_PROVIDER=sandbox

# Namecheap
NAMECHEAP_ENDPOINT=https://api.namecheap.com/xml.response
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=
NAMECHEAP_CLIENT_IP=127.0.0.1

NAMECHEAP_FIRST_NAME=
NAMECHEAP_LAST_NAME=
NAMECHEAP_ADDRESS1=
NAMECHEAP_ADDRESS2=
NAMECHEAP_CITY=
NAMECHEAP_STATE_PROVINCE=
NAMECHEAP_POSTAL_CODE=
NAMECHEAP_COUNTRY=
NAMECHEAP_PHONE=
NAMECHEAP_EMAIL_ADDRESS=

# OVHcloud
OVH_ENDPOINT=https://eu.api.ovh.com/1.0
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
OVH_SUBSIDIARY=FR

# Custom (any HTTP/JSON registrar gateway)
CUSTOM_REGISTRAR_ENDPOINT=
CUSTOM_REGISTRAR_API_KEY=

# --- OMNEX Drive (object storage) -------------------------------------------
# OMNEX_STORAGE_PROVIDER selects the object store: sandbox (in-memory) or s3.
# The S3-compatible provider activates only once its credentials are filled in.

OMNEX_STORAGE_PROVIDER=sandbox
OMNEX_STORAGE_QUOTA_BYTES=10737418240
OMNEX_STORAGE_SIGNED_URL_TTL=300

# S3-compatible (AWS S3, Cloudflare R2, MinIO, OVH Object Storage)
OMNEX_STORAGE_S3_ENDPOINT=
OMNEX_STORAGE_S3_REGION=us-east-1
OMNEX_STORAGE_S3_BUCKET=
OMNEX_STORAGE_S3_KEY=
OMNEX_STORAGE_S3_SECRET=
